import os
import random
import time
import requests
import pandas as pd
from dotenv import load_dotenv
from datetime import datetime
from requests.adapters import HTTPAdapter, Retry

# Load .env configuration
load_dotenv()

USE_PROXY = os.getenv("USE_PROXY", "false").lower() == "true"
PROXY_POOL = os.getenv("PROXY_POOL", "").split(",")

NBA_MAX_RETRIES = int(os.getenv("NBA_MAX_RETRIES", 7))
NBA_TIMEOUT = int(os.getenv("NBA_REQUEST_TIMEOUT_SECONDS", 70))
NBA_BASE_SLEEP = float(os.getenv("NBA_BASE_SLEEP_SECONDS", 1.0))
NBA_ALLOW_DIRECT_FALLBACK = os.getenv("NBA_ALLOW_DIRECT_FALLBACK", "true").lower() == "true"

def get_rotating_proxy():
    """Return a random Decodo proxy from pool."""
    if not USE_PROXY or not PROXY_POOL:
        return None
    proxy = random.choice(PROXY_POOL)
    return {"http": proxy, "https": proxy}

def fetch_daily_games():
    today = datetime.now().strftime("%Y-%m-%d")

    nba_url = "https://stats.nba.com/stats/scoreboardv3"
    params = {
        "GameDate": today,
        "LeagueID": "00",
        "DayOffset": "0"
    }

    headers = {
        "User-Agent": "Mozilla/5.0",
        "Referer": "https://www.nba.com/",
        "Origin": "https://www.nba.com",
        "Connection": "close",
    }

    # Retry session for robust NBA requests
    session = requests.Session()
    retry_logic = Retry(
        total=NBA_MAX_RETRIES,
        backoff_factor=0.3,
        status_forcelist=[429, 500, 502, 503, 504]
    )
    session.mount("https://", HTTPAdapter(max_retries=retry_logic))

    proxy_used = None
    attempt = 0

    while attempt < NBA_MAX_RETRIES:
        attempt += 1

        proxies = get_rotating_proxy()
        proxy_used = proxies

        try:
            resp = session.get(
                nba_url,
                params=params,
                headers=headers,
                timeout=NBA_TIMEOUT,
                proxies=proxies,
            )
            resp.raise_for_status()
            data = resp.json()
            break  # success

        except Exception as e:
            print(f"[Attempt {attempt}/{NBA_MAX_RETRIES}] Error: {e}")
            time.sleep(NBA_BASE_SLEEP)

            # Allow fallback to direct connection
            if NBA_ALLOW_DIRECT_FALLBACK and attempt == NBA_MAX_RETRIES:
                print("⚠️ All proxy attempts failed — trying direct (no proxy)...")
                try:
                    resp = session.get(
                        nba_url,
                        params=params,
                        headers=headers,
                        timeout=NBA_TIMEOUT,
                    )
                    resp.raise_for_status()
                    data = resp.json()
                    break
                except Exception as e2:
                    print("❌ Direct fallback also failed:", e2)
                    return

    session.close()

    # Extract games
    games = data.get("scoreboard", {}).get("games", [])

    if not games:
        print("No NBA games today.")
        return

    rows = []
    for g in games:
        rows.append({
            "date": today,
            "game_id": g["gameId"],
            "home_team": g["homeTeam"]["teamTricode"],
            "away_team": g["awayTeam"]["teamTricode"],
            "home_id": g["homeTeam"]["teamId"],
            "away_id": g["awayTeam"]["teamId"],
            "home_score": g["homeTeam"]["score"],
            "away_score": g["awayTeam"]["score"],
            "game_status": g["gameStatusText"],
            "proxy_used": proxy_used["http"] if proxy_used else "DIRECT"
        })

    df = pd.DataFrame(rows)
    out_path = f"games_{today}.csv"
    df.to_csv(out_path, index=False)

    print(f"✔ Saved: {out_path}")
    print(df)

if __name__ == "__main__":
    fetch_daily_games()
